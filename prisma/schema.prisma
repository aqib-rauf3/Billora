generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  business  String?
  createdAt DateTime   @default(now())
  customers Customer[]
  invoices  Invoice[]
  estimates Estimate[]
  expenses  Expense[]
  products      Product[]
  payments      Payment[]
  notifications Notification[]
  recurringInvoices RecurringInvoice[]

  // Email verification — null until the user clicks the emailed link.
  // Mandatory: the app middleware blocks (app) routes while this is null.
  emailVerified            DateTime?
  verificationToken        String?   @unique
  verificationTokenExpiry  DateTime?

  // Forgot / reset password
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?
  company   String?
  notes     String?
  tags      String[]  @default([])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  invoices  Invoice[]
  estimates Estimate[]
  recurringInvoices RecurringInvoice[]
  createdAt DateTime  @default(now())
}

model Invoice {
  id         String        @id @default(cuid())
  number     String
  status     String        @default("draft") // draft, pending, paid, overdue
  issueDate  DateTime
  dueDate    DateTime
  taxPercent Float         @default(0)
  // Discount is applied to the subtotal before tax. "percent" reads
  // discountValue as a % (0-100); "fixed" reads it as a flat Rs. amount.
  discountType  String     @default("percent") // percent | fixed
  discountValue Float      @default(0)
  note       String?
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  items      InvoiceItem[]
  payments   Payment[]
  createdAt  DateTime      @default(now())

  // Shareable read-only link — null until "Share" is clicked on the
  // invoice detail page. Looked up (not the invoice id) by the public
  // /i/[token] page so ids stay unguessable-safe on their own merit.
  shareToken String? @unique

  // Set when this invoice was auto-generated by a RecurringInvoice
  // template (null for regular one-off invoices).
  recurringSourceId String?
  recurringSource   RecurringInvoice? @relation(fields: [recurringSourceId], references: [id])
}

// A saved "template" that periodically generates a real Invoice — the
// customer, line items, tax/discount are copied onto each generated
// invoice; only the number/dates change per run. Created from the
// "Make this recurring" toggle on Invoices > Create.
model RecurringInvoice {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  customerId    String
  customer      Customer               @relation(fields: [customerId], references: [id])
  interval      String                 // weekly | monthly | quarterly | yearly
  taxPercent    Float                  @default(0)
  discountType  String                 @default("percent")
  discountValue Float                  @default(0)
  note          String?
  active        Boolean                @default(true)
  nextRunDate   DateTime
  lastRunDate   DateTime?
  createdAt     DateTime               @default(now())
  items         RecurringInvoiceItem[]
  invoices      Invoice[]
}

model RecurringInvoiceItem {
  id                 String           @id @default(cuid())
  desc               String
  qty                Int              @default(1)
  rate               Float
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  desc      String
  qty       Int     @default(1)
  rate      Float
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model Estimate {
  id         String    @id @default(cuid())
  number     String?
  validUntil String?
  amount     Float     @default(0)
  status     String    @default("pending") // pending, approved, rejected
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  unit        String?  // e.g. "hour", "item", "project" — shown next to price
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  amount    Float
  method    String   @default("bank_transfer") // bank_transfer, cash, card, other
  note      String?
  paidAt    DateTime @default(now())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // welcome, payment_received, invoice_overdue
  message   String
  link      String?
  // Dedupe key for lazily-generated notifications (e.g. one
  // "invoice_overdue" per invoice, not one per day it stays overdue) — null
  // for one-off notifications like "welcome".
  entityId  String?
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, type, entityId])
}
